candidate_prefix="Blackcoin-${HOTFIX_CANDIDATE_RELEASE_VERSION}-candidate-${candidate_short_sha}"

export CONFIRM_HOTFIX_CANDIDATE_PHASE_A="v${HOTFIX_CANDIDATE_RELEASE_VERSION}-hotfix-candidate-${candidate_short_sha}-node27-phase-a-rewind-safe"
export PHASE_A_EVIDENCE_DIR="/mnt/pulsar/Blackcoin_Blocks/operations/releases/v${HOTFIX_CANDIDATE_RELEASE_VERSION}-${HOTFIX_CANDIDATE_SOURCE_SHA}/__EXACT_PHASE_A_EVIDENCE_DIR__"
export PHASE_A_RESULT_SHA256='__64_HEX_PHASE_A_RESULT__'
export CONFIRM_HOTFIX_CANDIDATE_PHASE_B="v${HOTFIX_CANDIDATE_RELEASE_VERSION}-hotfix-candidate-${candidate_short_sha}-node27-promote-no-data-rewind:__64_HEX_PHASE_A_RESULT__"

export CANDIDATE_BUNDLE_DIR="/mnt/pulsar/Blackcoin_Blocks/operations/hotfix-candidates/${candidate_short_sha}/__EXACT_BUNDLE_DIR__"
