export CANDIDATE_IMAGE="qqblackcoin/blackcoin-v4-gui:${HOTFIX_CANDIDATE_RELEASE_VERSION}-candidate-${candidate_short_sha}-ci1"
export CANDIDATE_IMAGE_ID='sha256:__64_HEX_LOADED_IMAGE_CONFIG__'
