# shellcheck shell=bash
# IDENTITY-UNRESOLVED, NONDEPLOYABLE TEMPLATE. Do not copy or source this file
# until `__FINAL_SIGNED_CORE_SHA__` and `__FINAL_EXACT_SHA_CORE_CI_RUN_ID__`
# have been replaced by one reviewed exact source/run pair and every remaining
# bundle/evidence placeholder has been populated from one independently
# reviewed sealed candidate. The PR safety run is not the later candidate
# packaging run; CANDIDATE_GITHUB_RUN_ID and its attempt remain unresolved.
#
# After that repin, copy the reviewed template to a root-owned 0600 file outside
# the repository and replace every remaining placeholder from the same
# checksum-verified candidate bundle. This file contains no wallet secret.
# Never source it with a placeholder intact.

# Phase A and Phase B are separately authorized transactions. Never pre-fill
# the Phase-B confirmation before Phase A has a verified final RESULT hash.
export HOTFIX_CANDIDATE_SOURCE_SHA='__FINAL_SIGNED_CORE_SHA__'
